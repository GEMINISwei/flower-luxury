include /etc/nginx/snippets/trusted-proxy.conf;

# 給下面的 Next.js HMR 用。不要因為「後端沒有 WebSocket」就刪掉, 熱更新會安靜地停掉。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    absolute_redirect off;

    resolver 127.0.0.11 valid=10s;

    # 以下與 default.conf.template 相同, 理由都寫在那份與 snippets/ 裡。
    client_max_body_size 16m;
    include /etc/nginx/snippets/security-headers.conf;

    # 刻意沒有 `location /api/`。dev 必須跟 prod 一致, 否則開發時寫得出
    # 「瀏覽器直接打後端」的程式, 到 prod 才壞。

    # Next.js HMR。路徑由 Next 決定而且升級時會改 (16.3 從 /_next/webpack-hmr 改成這個),
    # 對不上時熱更新會安靜地停掉。升 Next 後改動沒自動反映, 先確認這裡。
    location /_next/hmr {
        set $frontend_upstream http://web:3000;
        proxy_pass         $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host       $host;
    }

    # 照片讀取須通過後端登入驗證, 一般 API 維持由 Server Component/Action 呼叫.
    location ~ ^/api/products/photos/[0-9a-f-]+/(file|download)$ {
        limit_except GET { deny all; }
        set $photo_upstream http://api:8000;
        proxy_pass $photo_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # LINE 只公開簽章驗證入口, 群組管理維持內網呼叫.
    location = /api/line/webhook {
        limit_except POST { deny all; }
        set $line_upstream http://api:8000;
        proxy_pass $line_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Frontend
    location / {
        set $frontend_upstream http://web:3000;
        proxy_pass $frontend_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}
